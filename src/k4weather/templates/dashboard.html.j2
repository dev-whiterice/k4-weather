{#
  Dashboard layout. Everything here is declarative: values arrive already
  rounded and formatted from model.py, and coordinates are already in the SVG
  units of the final PNG. On-screen copy is Italian on purpose.
#}
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<title>{{ d.location }} — {{ d.date_long }}</title>
{# Fonts first: they are inlined as data URIs so the page loads offline. #}
<style>{{ font_face_css }}</style>
<style>{{ styles }}</style>
</head>
<body>

<section class="header">
  <div class="location">{{ d.location }}</div>
  <div class="date">{{ d.date_long }}</div>
</section>

{# Current conditions. Everything outdoors sits on the left of the rule — the
   temperature, what it feels like, the day's high and low — and the reading
   that comes from inside the room sits on the right of it, so the two can
   never be mistaken for one another. #}
<section class="current{% if d.indoor %} split{% endif %}">
  <div class="now-icon">{{ icon(d.icon) }}</div>
  <div class="now-main">
    <div class="group-label">esterna</div>
    <div class="temp">{{ d.temperature }}<span class="deg">°</span></div>
    <div class="condition">{{ d.condition }}</div>
  </div>
  <div class="now-range">
    <div class="range-row">
      <span class="range-key">max</span>
      <span class="range-val">{{ d.today_max }}</span>
    </div>
    <div class="range-row">
      <span class="range-key">min</span>
      <span class="range-val">{{ d.today_min }}</span>
    </div>
    <div class="range-row">
      <span class="range-key">percepita</span>
      <span class="range-val">{{ d.apparent }}</span>
    </div>
  </div>

  {#- The indoor temperature. The Kindle writes the number itself into this
      box — with fbink, or with eips where fbink is not installed: the sensor is
      on the device and this image is built in the cloud. It is the one element
      on the page whose position has to be exact to the pixel, since both those
      programs write on a fixed character grid, so it carries the coordinates
      model.py computed, and the rule, the label and the degree sign hang off it
      instead of being laid out beside it. The dash is what shows until the
      device fills it in, or if its sensor cannot be read. #}
  {%- if d.indoor %}
  <div class="indoor-slot" style="left: {{ d.indoor.x }}px; top: {{ d.indoor.y }}px;
       width: {{ d.indoor.width }}px; height: {{ d.indoor.height }}px"
  ><i class="indoor-rule"></i
  ><span class="group-label indoor-label">interna</span
  ><span class="indoor-deg">°</span>–</div>
  {%- endif %}
</section>

<section class="metrics">
  {% for m in d.metrics %}
  <div class="metric">
    <div class="m-label">{{ m.label }}</div>
    <div class="m-value">{{ m.value }}{% if m.unit or m.note %}<span class="m-unit">{{ m.unit }}{% if m.note %} {{ m.note }}{% endif %}</span>{% endif %}</div>
  </div>
  {% endfor %}
</section>

{# Hourly chart: temperature curve on top, rain probability bars underneath,
   hour labels below both. The extra 18px of height are for those labels. #}
<section class="hourly">
  <div class="section-head">
    <div class="section-title">{{ d.hourly_title }}</div>
    <div class="legend"><span class="swatch"></span>probabilità di pioggia</div>
  </div>
  <svg class="chart" width="{{ d.chart_width }}" height="{{ d.chart_height + 18 }}"
       viewBox="0 0 {{ d.chart_width }} {{ d.chart_height + 18 }}">
    <path class="area" d="{{ d.temp_area_path }}"/>
    <path class="line" d="{{ d.temp_path }}"/>

    {# Only the coldest and warmest hours get a marker and a number. #}
    {%- for h in d.hours if h.is_extreme %}
    {# The halo punches a hole in the curve so the dot stays readable. #}
    <circle class="marker-halo" cx="{{ '%.2f'|format(h.x) }}" cy="{{ '%.2f'|format(h.temp_y) }}" r="5"/>
    <circle class="marker" cx="{{ '%.2f'|format(h.x) }}" cy="{{ '%.2f'|format(h.temp_y) }}" r="3"/>
    <text class="marker-label"
          x="{{ '%.2f'|format(h.label_x) }}" y="{{ '%.2f'|format(h.label_y) }}"
          text-anchor="middle">{{ h.temp }}°</text>
    {%- endfor %}

    <g transform="translate(0 {{ d.chart_temp_height + 6 }})">
      <line class="baseline" x1="0" y1="{{ d.chart_bars_height }}"
            x2="{{ d.chart_width }}" y2="{{ d.chart_bars_height }}"/>
      {%- for h in d.hours if h.precip_probability > 0 %}
      <rect class="bar" x="{{ '%.2f'|format(h.x - 3) }}" y="{{ '%.2f'|format(h.bar_y) }}"
            width="6" height="{{ '%.2f'|format(h.bar_height) }}" rx="1.5"/>
      {%- endfor %}
    </g>

    <g transform="translate(0 {{ d.chart_height }})">
      {%- for h in d.hours if h.show_label %}
      {# The first label is anchored to the start, or it would be clipped. #}
      <text class="hour" x="{{ '%.2f'|format(h.x) }}" y="14"
            text-anchor="{% if loop.first %}start{% else %}middle{% endif %}">{{ h.label }}</text>
      {%- endfor %}
    </g>
  </svg>
</section>

{# Multi-day grid. The min/max bars share one scale across all rows, so the
   shape of the week reads from their position alone. #}
<section class="daily">
  {% for day in d.days %}
  <div class="day">
    <div class="d-name">{{ day.name }}</div>
    <div class="d-icon">{{ icon(day.icon) }}</div>
    <div class="d-min">{{ day.temp_min }}</div>
    <div class="d-track">
      <div class="d-fill" style="left: {{ '%.2f'|format(day.bar_x) }}px; width: {{ '%.2f'|format(day.bar_width) }}px;"></div>
    </div>
    <div class="d-max">{{ day.temp_max }}</div>
    <div class="d-precip{% if not day.precip_probability %} none{% endif %}">{{ day.precip_label }}</div>
    <div class="d-wind">{{ day.wind }}<span class="d-unit">{{ d.wind_unit }}</span></div>
  </div>
  {% endfor %}
</section>

<section class="footer{% if d.battery %} with-battery{% endif %}">
  <div class="foot-left">
    {%- if d.sunrise %}
    <div class="foot-item">{{ icon('sunrise') }}<span>{{ d.sunrise }}</span></div>
    <div class="foot-item">{{ icon('sunset') }}<span>{{ d.sunset }}</span></div>
    {%- endif %}
    {%- if d.moon_svg %}
    <div class="foot-item">{{ d.moon_svg }}<span>{{ d.moon_name }} {{ d.moon_illumination }}</span></div>
    {%- endif %}
  </div>
  <div class="foot-note">
    {# Shown when the observation is older than STALE_AFTER: the image is
       fresh, the data behind it is not. #}
    {%- if d.stale %}<span class="stale">dati non aggiornati</span> · {% endif -%}
    Open-Meteo · agg. {{ d.updated_at }}
  </div>

  {#- The battery level, and the same arrangement as the indoor temperature
      upstairs: the Kindle writes the number itself into this box, because the
      gas gauge is on the device and this image is built in the cloud. Hence
      the pixel coordinates, hence the icon and the per-cent sign hanging off
      the slot rather than being laid out beside it, and hence the dash — which
      is what shows until the device fills it in, and if it cannot be read.
      Refreshed with the page, so it is a reading from the last half hour and
      not a live one. #}
  {%- if d.battery %}
  <div class="battery-slot" style="left: {{ d.battery.x }}px; top: {{ d.battery.y }}px;
       width: {{ d.battery.width }}px; height: {{ d.battery.height }}px"
  ><i class="battery-icon">{{ icon('battery') }}</i
  ><span class="battery-unit">%</span>–</div>
  {%- endif %}
</section>

</body>
</html>
